#
# fanchmwrt 25.12.4 · 小米 AX3000T（stock 分区布局）
# ★ PassWall 精简版 —— 代理组件仅 sing-box
#
# 这是「增量配置」，不是完整 .config：
#   workflow 里 cp 本文件到源码根目录后执行 `make defconfig`，
#   未列出的选项由 Kconfig 默认值补齐（含设备默认包集）。
#
# 设备名 xiaomi_mi-router-ax3000t 即 stock 布局；
# 大分区（OpenWrt U-Boot）对应的是 xiaomi_mi-router-ax3000t-ubootmod，本配置不使用。
#
# 与 ax3000t-stock.config（完整版）的差异只在 PassWall 段：
#   砍 shadowsocks-rust / shadowsocksr-libev / simple-obfs / v2ray-plugin / haproxy，
#   PassWall 透明代理链 = sing-box-tiny + ipt2socks（+ 依赖自动带入的
#   chinadns-ng / dns2socks / tcping / microsocks）。
#   其余应用（HomeProxy / EasyTier / frps / vlmcsd / rtp2httpd / DDNS / pushbot）全保留。
#   副作用：SS / SSR 节点不可用，多节点负载均衡（haproxy）不可用。
#   最大收益：不再编译 shadowsocks-rust → 不拖入 LLVM + rustc（省约 2 小时）。
#

# ------------------------------------------------------------------
# 目标平台 / 设备
# ------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ------------------------------------------------------------------
# 基础系统 / 界面
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_CCACHE=y

# ------------------------------------------------------------------
# openssh-sftp-server（核心树自带，给 WinSCP / sftp 传文件用）
# ------------------------------------------------------------------
CONFIG_PACKAGE_openssh-sftp-server=y

# ------------------------------------------------------------------
# PassWall（来源：Openwrt-Passwall/openwrt-passwall + -packages）—— 精简版
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# 透明代理：firewall4 环境下走 nftables
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=n

# ★ 所有 INCLUDE_* 全部为 n（除下面显式说明的）：
#   这些段是 luci-app-passwall/Makefile 里 define Package/.../config 的**原生 Kconfig**，
#   每个 `select PACKAGE_xxx` 的优先级都高于 .config 手写值 ——
#   只写 `# CONFIG_PACKAGE_xxx is not set` 会被 make defconfig 翻回 y。
#   真正能关掉 select 的只有把对应 INCLUDE_* 设为 n。

# Xray 核心：不编译（PassWall 核心探测是运行时的「先 sing-box 后 xray」，
# 有 /usr/bin/sing-box 就照常工作）。代价：XHTTP 等 Xray 独有协议不可用。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n

# ★ 必须为 n：PassWall 写的是无条件 `select PACKAGE_sing-box`，
#   为 y 时会硬拉 full 版 sing-box，与下面的 sing-box-tiny（CONFLICTS:=sing-box）撞车。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n

# ★ Geoview：不编译（省 4–6 MB；需要时 `apk add geoview` 从源里补装）。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n

# ↓↓↓ 精简版新增的砍除项（完整版里为 y 的五个）↓↓↓
# haproxy：多节点负载均衡，精简版不要。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
# shadowsocks-rust（sslocal）：SS 协议客户端。
# 它 PKG_BUILD_DEPENDS:=rust/host，源码要现场编 LLVM + rustc，独占约 1h52m —— 精简的最大收益点。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
# shadowsocksr-libev：SSR 协议。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
# simple-obfs / v2ray-plugin：SOCKS 混淆插件（v2ray-plugin 是 Go 包）。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
# v2ray-geodata：解包后约 25~30MB。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n

# ipt2socks 是 PassWall 透明代理（Nftables/Iptables 两种模式都 select 它）的必需件，保留。
# chinadns-ng / dns2socks / tcping / microsocks 在 LUCI_DEPENDS 里，由依赖自动带入。
CONFIG_PACKAGE_ipt2socks=y

# 被砍组件显式写下「未启用」以备核对（对应源包仍装进 feeds，
# 否则 INCLUDE_* 符号不存在、上面的 =n 会被 make defconfig 静默丢行）：
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_simple-obfs-client is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_geoview is not set

# ------------------------------------------------------------------
# sing-box：tiny 变体（来源：OpenWrt 官方 packages feed）
# ------------------------------------------------------------------
# 官方 net/sing-box 一个 Makefile 产出两个包：
#   sing-box      VARIANT:=full  DEFAULT_VARIANT:=1   → /usr/bin/sing-box
#   sing-box-tiny VARIANT:=tiny  PROVIDES:=sing-box   → /usr/bin/sing-box（同一路径）
#                 CONFLICTS:=sing-box
# tiny 保留 with_gvisor / with_quic / with_utls / with_clash_api，
# 砍掉 tailscale / wireguard / grpc / v2ray_api / acme / dhcp / embedded_tor / openvpn，
# 二进制从 ~35MB 降到 ~15MB。
# ★ HomeProxy 的 +sing-box（虚拟依赖）不会把 full 版拉回来：
#   tiny=y 时 metadata.pl 生成的条件 select 不成立，机制与完整版相同。
CONFIG_PACKAGE_sing-box-tiny=y

# ------------------------------------------------------------------
# 「取消列表」—— 明确不编译的包（workflow 逐条断言）
# ------------------------------------------------------------------
# 这些都由 INCLUDE_*/select 引入，select 优先级高于 .config，
# 必须在源头把对应 INCLUDE_* 关掉（见上文）才真正生效。
# ------------------------------------------------------------------
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_geoview is not set
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_shadowsocks-rust is not set
# CONFIG_PACKAGE_shadowsocksr-libev is not set
# CONFIG_PACKAGE_simple-obfs-client is not set
# CONFIG_PACKAGE_v2ray-plugin is not set

# ------------------------------------------------------------------
# bind-host（BIND 9 的轻量 DNS 查询客户端，提供 /usr/bin/host）
# ------------------------------------------------------------------
CONFIG_PACKAGE_bind-host=y

# ------------------------------------------------------------------
# luci-app-pushbot（全能推送）
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-pushbot=y
CONFIG_PACKAGE_luci-i18n-pushbot-zh-cn=y

# ------------------------------------------------------------------
# HomeProxy（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# ------------------------------------------------------------------
# EasyTier（来源：EasyTier/luci-app-easytier）
# ------------------------------------------------------------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_EASYTIER_INCLUDE_WEBCONSOLE=y

# ------------------------------------------------------------------
# frps（服务端）+ LuCI
# ------------------------------------------------------------------
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y

# ------------------------------------------------------------------
# vlmcsd（KMS 服务端）+ LuCI
# ------------------------------------------------------------------
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# ------------------------------------------------------------------
# rtp2httpd（IPTV 组播转 HTTP）+ LuCI
# ------------------------------------------------------------------
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# ------------------------------------------------------------------
# DDNS：ddns-scripts 本体 + DNSPod 服务商脚本
# ------------------------------------------------------------------
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ------------------------------------------------------------------
# 代理链路依赖：显式固定，避免被 dependency 自动选择绕开
# ------------------------------------------------------------------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-tun=y
