#
# fanchmwrt 25.12.4 · 小米 AX3000T（stock 分区布局）
#
# 这是「增量配置」，不是完整 .config：
#   workflow 里 cp 本文件到源码根目录后执行 `make defconfig`，
#   未列出的选项由 Kconfig 默认值补齐（含设备默认包集）。
#
# 设备名 xiaomi_mi-router-ax3000t 即 stock 布局；
# 大分区（OpenWrt U-Boot）对应的是 xiaomi_mi-router-ax3000t-ubootmod，本配置不使用。
#

# ------------------------------------------------------------------
# 目标平台 / 设备
# ------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ------------------------------------------------------------------
# 基础系统 / 界面
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_CCACHE=y

# ------------------------------------------------------------------
# openssh-sftp-server（核心树自带，给 WinSCP / sftp 传文件用）
# ------------------------------------------------------------------
CONFIG_PACKAGE_openssh-sftp-server=y

# ------------------------------------------------------------------
# PassWall（来源：Openwrt-Passwall/openwrt-passwall + -packages）
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# 透明代理：firewall4 环境下走 nftables
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=n
# 内置内核与插件
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
# v2ray-geodata 解包后约 25~30MB，会明显挤压 stock 分区空间，按需再开
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n

# ------------------------------------------------------------------
# HomeProxy（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# ------------------------------------------------------------------
# EasyTier（来源：EasyTier/luci-app-easytier）
# ------------------------------------------------------------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_EASYTIER_INCLUDE_WEBCONSOLE=y

# ------------------------------------------------------------------
# frps（服务端）+ LuCI（来源：OpenWrt 官方 feed，版本与源码树同步）
# ------------------------------------------------------------------
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y

# ------------------------------------------------------------------
# vlmcsd（KMS 服务端）+ LuCI（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# ------------------------------------------------------------------
# rtp2httpd（IPTV 组播转 HTTP）+ LuCI（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# ------------------------------------------------------------------
# DDNS：ddns-scripts 本体 + DNSPod 服务商脚本（来源：OpenWrt 官方 feed）
# ------------------------------------------------------------------
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ------------------------------------------------------------------
# 代理链路依赖：显式固定，避免被 dependency 自动选择绕开
# ------------------------------------------------------------------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-tun=y
