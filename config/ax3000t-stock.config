#
# fanchmwrt 25.12.4 · 小米 AX3000T（stock 分区布局）
#
# 这是「增量配置」，不是完整 .config：
#   workflow 里 cp 本文件到源码根目录后执行 `make defconfig`，
#   未列出的选项由 Kconfig 默认值补齐（含设备默认包集）。
#
# 设备名 xiaomi_mi-router-ax3000t 即 stock 布局；
# 大分区（OpenWrt U-Boot）对应的是 xiaomi_mi-router-ax3000t-ubootmod，本配置不使用。
#

# ------------------------------------------------------------------
# 目标平台 / 设备
# ------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ------------------------------------------------------------------
# 基础系统 / 界面
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_CCACHE=y

# ------------------------------------------------------------------
# openssh-sftp-server（核心树自带，给 WinSCP / sftp 传文件用）
# ------------------------------------------------------------------
CONFIG_PACKAGE_openssh-sftp-server=y

# ------------------------------------------------------------------
# PassWall（来源：Openwrt-Passwall/openwrt-passwall + -packages）
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# 透明代理：firewall4 环境下走 nftables
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=n
# 内置内核与插件
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
# ★ 必须为 n：PassWall 写的是无条件 `select PACKAGE_sing-box`，
#   为 y 时会硬拉 full 版 sing-box，与下面的 sing-box-tiny（CONFLICTS:=sing-box）撞车。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
# v2ray-geodata 解包后约 25~30MB，会明显挤压 stock 分区空间，按需再开
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n

# 上面这些 INCLUDE_* 全部靠 Kconfig 的 `select PACKAGE_xxx` 生效（不在 LUCI_DEPENDS 里），
# 前提是对应源包已被装进 package/feeds/。这里再显式写死一遍：
# 源包缺失时 make defconfig 会把这些行丢掉，紧接着的配置校验就会 fail，
# 而不是像 run #5 那样静默产出一个缺 geoview / ipt2socks 的固件。
# ipt2socks 是 PassWall 透明代理（Nftables/Iptables 两种模式都 select 它）的必需件。
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y

# ------------------------------------------------------------------
# sing-box：用 tiny 变体替换 full 版（来源：OpenWrt 官方 packages feed）
# ------------------------------------------------------------------
# 官方 net/sing-box 一个 Makefile 产出两个包：
#   sing-box      VARIANT:=full  DEFAULT_VARIANT:=1   → /usr/bin/sing-box
#   sing-box-tiny VARIANT:=tiny  PROVIDES:=sing-box   → /usr/bin/sing-box（同一路径）
#                 CONFLICTS:=sing-box
# tiny 保留 with_gvisor / with_quic / with_utls / with_clash_api，
# 砍掉 tailscale / wireguard / grpc / v2ray_api / acme / dhcp / embedded_tor / openvpn，
# 二进制从 ~35MB 降到 ~15MB —— 对 78MiB 的 stock rootfs 是最大一笔空间回收。
#
# ★ 为什么 HomeProxy 的 +sing-box 不会把 full 版拉回来：
#   它走的是 LUCI_DEPENDS 里的 `+sing-box`（虚拟依赖）。metadata.pl 处理带 + 的虚拟依赖时
#   （mconf_depends: $flags =~ /\+/ 分支）会把默认变体排在最前，其余变体写成条件：
#       select PACKAGE_sing-box if PACKAGE_sing-box-tiny<PACKAGE_luci-app-homeproxy
#   本行 tiny=y 后该条件不成立，于是 full 版不会被 select。
#
# 注：PassWall 的 INCLUDE_SingBox 只决定“要不要把 sing-box 打进固件”，
#     不决定运行时能否用 —— /usr/bin/sing-box 存在，PassWall 面板照样认。
CONFIG_PACKAGE_sing-box-tiny=y
# CONFIG_PACKAGE_sing-box is not set

# ------------------------------------------------------------------
# bind-host（BIND 9 的轻量 DNS 查询客户端，提供 /usr/bin/host）
# 来源：OpenWrt 官方 packages feed（net/bind 拆出的子包）
# ------------------------------------------------------------------
# 只装 host 这一个可执行文件；它依赖的 bind-libs（libdns/libisc 等）由依赖自动带入。
CONFIG_PACKAGE_bind-host=y

# ------------------------------------------------------------------
# luci-app-pushbot（全能推送：钉钉 / 企业微信 / 飞书 / Bark / PushPlus / ntfy …）
# 来源：zzsj0928/luci-app-pushbot（master）
# ------------------------------------------------------------------
# 该仓库是「根目录即包目录」的单包结构，Makefile 在仓库根 → 不能作为 feed 挂载
# （scripts/feeds 的 crawl 只认 <feed>/<包名>/Makefile 这一层）。
# 所以由 workflow 直接 git clone 到 package/luci-app-pushbot 当本地包，这也是上游 CI 的做法。
# v5.10 起纯 ucode 架构（无 Lua/CBI），要求 LuCI ≥ 23.05 —— fanchmwrt 25.12.4 满足。
# LUCI_DEPENDS 里的 +luci-base +iputils-arping +curl +jq 由依赖自动带入。
CONFIG_PACKAGE_luci-app-pushbot=y
CONFIG_PACKAGE_luci-i18n-pushbot-zh-cn=y

# ------------------------------------------------------------------
# HomeProxy（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# ------------------------------------------------------------------
# EasyTier（来源：EasyTier/luci-app-easytier）
# ------------------------------------------------------------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_EASYTIER_INCLUDE_WEBCONSOLE=y

# ------------------------------------------------------------------
# frps（服务端）+ LuCI（来源：OpenWrt 官方 feed，版本与源码树同步）
# ------------------------------------------------------------------
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y

# ------------------------------------------------------------------
# vlmcsd（KMS 服务端）+ LuCI（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# ------------------------------------------------------------------
# rtp2httpd（IPTV 组播转 HTTP）+ LuCI（来源：ImmortalWrt 25.12）
# ------------------------------------------------------------------
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# ------------------------------------------------------------------
# DDNS：ddns-scripts 本体 + DNSPod 服务商脚本（来源：OpenWrt 官方 feed）
# ------------------------------------------------------------------
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ------------------------------------------------------------------
# 代理链路依赖：显式固定，避免被 dependency 自动选择绕开
# ------------------------------------------------------------------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-tun=y
